% ---------- Secciones institucionales (formato FPLAN) ----------
% \matrizevaluacion{cognitiva}{procedimental}{socioafectiva}{trascendente}
\newcommand{\mmc@casilla}{\large$\square$}
% Imprime también el título de sección, para que nunca quede solo al pie de página.
\newcommand{\matrizevaluacion}[4]{%
  \par\Needspace{24\baselineskip}% título + matriz completa (filas de varias líneas)
  \seccion{Evaluación del periodo}%
  \subsubsection*{Matriz de evaluación formativa}
  {\small\renewcommand{\arraystretch}{1.5}%
  \begin{tabularx}{\linewidth}{@{}l X c c c@{}}
    \toprule
    \textbf{Dimensión} & \textbf{Criterio de evaluación} &
    \textbf{Lo logré} & \textbf{Voy en camino} & \textbf{Necesito apoyo}\\
    \midrule
    Cognitiva (Saber)        & #1 & \mmc@casilla & \mmc@casilla & \mmc@casilla\\
    Procedimental (Hacer)    & #2 & \mmc@casilla & \mmc@casilla & \mmc@casilla\\
    Socioafectiva (Ser)      & #3 & \mmc@casilla & \mmc@casilla & \mmc@casilla\\
    Trascendente (Convivir)  & #4 & \mmc@casilla & \mmc@casilla & \mmc@casilla\\
    \bottomrule
  \end{tabularx}}\par}

\newcommand{\autoevaluacion}{%
  \Needspace{10\baselineskip}%
  \subsubsection*{Autoevaluación y reflexión metacognitiva}
  Lo que más me gustó de esta guía fue:\renglones{1}
  La mayor dificultad que tuve y cómo la superé:\renglones{2}
  Mi compromiso para el próximo periodo es:\renglones{1}}

\newcommand{\seguimientodocente}{%
  \Needspace{12\baselineskip}%
  \subsubsection*{Seguimiento y apoyos \normalfont\small(diligenciado por el docente)}
  \textbf{Nivel de desempeño alcanzado:}\quad
  $\square$ Inicial\quad $\square$ En proceso\quad $\square$ Consolidado\par
  \textbf{Ajustes DUA/PIAR aplicados:}\renglones{2}
  \textbf{Observaciones y recomendaciones:}\renglones{2}
  \vspace{1.5em}
  \noindent\makebox[0.42\linewidth]{\hrulefill}\hfill\makebox[0.42\linewidth]{\hrulefill}\\
  \makebox[0.42\linewidth]{\small Firma del estudiante}\hfill
  \makebox[0.42\linewidth]{\small Firma del docente}\par}

% ---------- Referencias desde una clase a la guía del estudiante ----------
% En el preámbulo de clase.tex:
%   \guiadelestudiante{../../guia-didactica/guia-periodo-I-derivadas}
% (ruta al .tex de la guía, sin extensión; la guía debe estar compilada y
% conservar su .aux). En el texto:  \refguia{tema:pendiente}
%   -> «Guía del estudiante, Tema 1 (p. 3)»
\newcommand{\guiadelestudiante}[1]{\externaldocument[guia:]{#1}}
\newcommand{\refguia}[1]{%
  \emph{Guía del estudiante}, Tema~\ref{guia:#1} (p.~\pageref{guia:#1})}

