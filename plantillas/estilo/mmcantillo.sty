\sisetup{output-decimal-marker={,}, per-mode=symbol, group-minimum-digits=4}

% Operadores con tilde (lím, máx, mín, ínf…). En pdflatex, babel-spanish arma la «í» con
% la posición de «ı» de la codificación del texto (T1) pero dentro de la fuente de
% operadores (OT1), donde no existe: salía «lım» sin ningún error. Aquí la tilde se escribe
% como texto normal (T1 Palatino, que sí tiene «í»). Los operadores llaman a \es@op@ac al
% componerse, así que basta redefinirlo; también \es@op@ac@base, por si se vuelve a
% ejecutar \accentedoperators.
\def\es@op@ac@base#1{\text{\normalfont\'{#1}}}
\let\es@op@ac\es@op@ac@base

% Conjuntos numéricos
\newcommand{\N}{\mathbb{N}}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\Q}{\mathbb{Q}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\C}{\mathbb{C}}
% Delimitadores que se ajustan solos: \abs{x}, \norm{v}, \abs*{\frac{a}{b}}
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
% Cálculo: diferencial recto y derivadas
\newcommand{\dd}{\mathop{}\!\mathrm{d}}                    % \int f(x)\dd x
\newcommand{\dv}[2]{\frac{\mathrm{d}#1}{\mathrm{d}#2}}     % \dv{y}{x}
\newcommand{\pdv}[2]{\frac{\partial #1}{\partial #2}}      % \pdv{f}{x}
\newcommand{\vect}[1]{\vec{#1}}                            % \vect{F}
\newcommand{\eval}[3]{\left.#1\right|_{#2}^{#3}}           % \eval{F(x)}{a}{b}

