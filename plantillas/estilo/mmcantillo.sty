% ---------- Bloque de título ----------
% \encabezado            -> título + datos del estudiante
% \encabezado*           -> título sin datos del estudiante (documentos)
\newcommand{\mmc@etiqueta}{%
  \mmc@tipo\enspace·\enspace\mmc@asignatura
  \ifx\mmc@grado\@empty\else\enspace·\enspace Grado \mmc@grado\fi
  \ifx\mmc@periodo\@empty\else\enspace·\enspace Periodo \mmc@periodo\fi}

\newcommand{\mmc@titulobloque}{%
  {\small\bfseries\color{mmcAcento}\MakeUppercase{\textls[120]{\mmc@etiqueta}}}\par
  \vspace{0.1em}
  {\LARGE\bfseries\mmc@titulo\par}
  \ifx\mmc@hilo\@empty\else
    \vspace{0.15em}{\large\itshape\color{mmcGris}\mmc@hilo\par}%
  \fi
  \vspace{0.3em}
}
