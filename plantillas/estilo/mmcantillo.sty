% Estilo de ejes: \begin{axis}[mmc] ... \end{axis}
\pgfplotsset{
  mmc/.style={
    axis lines=middle,
    axis line style={mmcGris, -{Stealth[length=2mm]}},
    grid=major, grid style={mmcLinea!60, very thin},
    xlabel={$x$}, ylabel={$y$},
    every axis x label/.style={at={(ticklabel* cs:1)}, anchor=west},
    every axis y label/.style={at={(ticklabel* cs:1)}, anchor=south},
    tick label style={font=\footnotesize, color=mmcGris},
    /pgf/number format/use comma,
    width=0.62\linewidth, height=0.42\linewidth,
    samples=200, smooth, no marks,
    % En B/N las curvas se distinguen por el trazo, no por el color
    cycle list={
      {black, very thick},
      {black, very thick, dashed},
      {black!55, very thick},
      {black, thick, densely dotted}
    },
    enlargelimits=0.05,
  },
}

