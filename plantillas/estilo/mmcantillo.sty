% =====================================================================
% Guía del estudiante (trimestral)
% =====================================================================

% Frase introductoria: \frase{texto}{Autor, \emph{Obra} (año)}
\newcommand{\frase}[2]{%
  \par\vspace{0.8em}%
  \begin{center}\begin{minipage}{0.82\linewidth}
    \setlength{\parskip}{0.4em}%
    {\color{mmcLinea}\rule{\linewidth}{0.4pt}}\par
    {\large\itshape «#1»\par}
    {\raggedleft\small\color{mmcGris}--- #2\par}
    {\color{mmcLinea}\rule{\linewidth}{0.4pt}}\par
  \end{minipage}\end{center}
  \vspace{0.4em}}

% DBA oficial (texto literal de dba/): \begin{dba}[Grado 11 · DBA 5] ... \end{dba}
\newtcolorbox{dba}[1][]{mmccaja,
  colback=white, borderline={0.4pt}{0pt}{mmcLinea},
  coltitle=mmcAcento, fonttitle=\bfseries,
  title={Derecho Básico de Aprendizaje\if\relax\detokenize{#1}\relax\else\ (#1)\fi}}

% Cita textual en el marco teórico: \begin{cita}{Autor, fuente~\cite{clave}} ... \end{cita}
\NewDocumentEnvironment{cita}{m}
  {\begin{quote}\itshape «\ignorespaces}
  {\unskip»\par\nopagebreak\vspace{0.2em}%
   {\upshape\small\color{mmcGris}\raggedleft--- #1\par}\end{quote}}

% Paso del hilo conductor al inicio de cada tema
\newtcolorbox{hilo}{mmccaja,
  colback=mmcFondo, borderline west={3pt}{0pt}{mmcGris},
  coltitle=mmcAcento, fonttitle=\bfseries\upshape, fontupper=\itshape,
  title={Hilo conductor}}

% Aplicación real del tema: \begin{aplicacion}[Robótica] ... \end{aplicacion}
\newtcolorbox{aplicacion}[1][]{mmccaja,
  colback=white, borderline={0.6pt}{0pt}{mmcAcento, dashed},
  coltitle=mmcAcento, fonttitle=\bfseries,
  title={¿Para qué sirve?\if\relax\detokenize{#1}\relax\else\ #1\fi}}

% Resumen al final de cada tema (recuadro)
\newtcolorbox{resumen}{enhanced, sharp corners,
  colback=white, colframe=mmcAcento, boxrule=0.8pt,
  colbacktitle=mmcAcento, coltitle=white,
  fonttitle=\bfseries\small, title={\textls[100]{EN RESUMEN}},
  left=3mm, right=3mm, top=1.5mm, bottom=1.5mm,
  before upper={\setlength{\parskip}{0.2em}}}

% Tema numerado: \tema{La pendiente}\label{tema:pendiente}
\newcounter{tema}
\newcommand{\tema}[1]{%
