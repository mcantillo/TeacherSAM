% ---------- Secciones ----------
% \seccion{Selección múltiple} -> separador con título en versalitas
\newcommand{\seccion}[1]{%
  \par\vspace{0.9em}\Needspace{6\baselineskip}%
  {\color{mmcAcento}\bfseries\large#1}\par\vspace{-0.8em}%
  {\color{mmcLinea}\rule{\linewidth}{0.4pt}}\par\vspace{0.2em}}

% ---------- Preguntas ----------
% \begin{preguntas}
%   \pregunta[2] Enunciado...
% \end{preguntas}
% La numeración continúa entre bloques; los puntos son opcionales y se
% imprimen en el margen derecho.
\newcounter{pregunta}
\newcommand{\mmc@numero}[1]{%
  \tikz[baseline=(n.base)]\node[circle, fill=mmcAcento, text=white,
    inner sep=0pt, minimum size=1.45em, font=\footnotesize\bfseries](n){#1};}
\newenvironment{preguntas}{%
  \begin{list}{}{%
    \setlength{\leftmargin}{2.1em}\setlength{\labelwidth}{1.5em}%
    \setlength{\labelsep}{0.6em}\setlength{\itemsep}{1.3em}%
    \setlength{\topsep}{0.6em}\setlength{\parsep}{0.4em}}%
}{\end{list}}
\newcommand{\pregunta}[1][]{%
  \stepcounter{pregunta}%
  \item[\mmc@numero{\thepregunta}]%
  \if\relax\detokenize{#1}\relax\else
    \xdef\mmc@total{\fpeval{\mmc@total+#1}}%
    \leavevmode\rlap{\hskip\linewidth\hskip4mm%
      {\footnotesize\color{mmcGris}\num{#1}\,\ifdim#1pt=1pt pt\else pts\fi}}%  % 1,5 pts (coma decimal)
  \fi
  \ignorespaces}

% ---------- Opciones de selección múltiple ----------
% \begin{opciones} \item ... \end{opciones}        -> una debajo de otra
% \begin{opciones*}(4) \item ... \end{opciones*}   -> en columnas (2 por defecto)
\newlist{opciones}{enumerate}{1}
\setlist[opciones]{label=\textbf{\color{mmcAcento}\alph*)}, leftmargin=2em,
  itemsep=0.2em, topsep=0.3em}
\RequirePackage{tasks}
\NewTasksEnvironment[label=\textbf{\color{mmcAcento}\alph*)},
  label-width=1.3em, item-indent=1.8em, column-sep=1em,
  before-skip=0.3em, after-skip=0.1em]{opciones*}[\item](2)

% ---------- Espacio para responder ----------
% \espacio{4cm}   -> espacio en blanco
% \renglones{3}   -> renglones para escribir
\newcommand{\espacio}[1]{\par\vspace*{#1}}
\newcommand{\renglones}[1]{%
  \par\vspace{0.3em}%
  \foreach \i in {1,...,#1}{%
    {\color{mmcLinea}\rule{\linewidth}{0.4pt}}\par\vspace{0.7em}}}

% ---------- Soluciones (clave de respuestas) ----------
% Escribe \mostrarsoluciones en el preámbulo para imprimir la clave.
% \begin{solucion}[4cm] ... \end{solucion}: si las soluciones están
% ocultas, deja 4cm en blanco para que el estudiante responda.
\newif\ifmmc@soluciones
\newcommand{\mostrarsoluciones}{\mmc@solucionestrue}
% Para generar la clave sin editar el archivo:
%   pdflatex -jobname=quiz-clave "\def\clave{}\input{quiz}"
\ifdefined\clave\mmc@solucionestrue\fi
\NewEnviron{solucion}[1][0pt]{%
  \ifmmc@soluciones
    \begin{tcolorbox}[enhanced, frame hidden, sharp corners,
        colback=mmcFondo, left=3mm, right=3mm, top=1.5mm, bottom=1.5mm,
        borderline west={2pt}{0pt}{mmcAcento},
        before upper={{\bfseries Solución.}\ }]
      \BODY
    \end{tcolorbox}%
  \else
    \vspace*{#1}%
  \fi}

